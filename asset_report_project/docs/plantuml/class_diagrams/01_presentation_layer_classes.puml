@startuml PresentationLayerClasses

title Financial Position Report Generator - Presentation Layer
left to right direction

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam classAttributeIconSize 0

package "Presentation Layer\nasset_report.presentation.cli" #DCEBFA {
  class CLI <<module>> {
    + build_parser(): ArgumentParser
    + main(argv: Sequence(str) = None): int
  }
}

package "Application Layer" #E3EEFF {
  class FinancialAnalysisApp {
    + generate_financial_report(input_path, output_path, title): Path
    + generate_asset_report(input_path, output_path, title): Path
  }
}

package "Data Access Layer" #FFF0DA {
  class DataValidationError
}

class ArgumentParser <<Python standard library>>

CLI ..> ArgumentParser : configures
CLI ..> FinancialAnalysisApp : invokes
CLI ..> DataValidationError : handles

note bottom of CLI
  Input: structured asset and liability JSON
  Options: --output, --title, --version
  Output: a stand-alone HTML report path
end note

@enduml
