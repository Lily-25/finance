@startuml DataAccessLayerClasses

title Financial Position Report Generator - Data Access Layer Classes
top to bottom direction

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam classAttributeIconSize 0

package "JSON Data Access\nasset_report.data_access.json_repository" #FFF0DA {
  class DataValidationError {
  }

  class JSONReader {
    + read(path: Path): dict
  }

  class DataStandardizer {
    + standardize(data: dict): dict
    - {static} _standardize_item(item: object): object
  }

  class FinancialDataValidator {
    + REQUIRED_ROOT: tuple(str)
    + validate(data: dict): None
    - _validate_time_series(data: dict): None
    - _validate_statement(statement, name, require_item): None
    - {static} _validate_items(items: list, statement_name: str, section: str): None
  }

  class FinancialStatementMapper {
    + map(data: dict): FinancialStatementData or FinancialTimeSeriesData
    - _map_time_series(data: dict): FinancialTimeSeriesData
    - _map_statement(identity: dict, statement: dict): FinancialStatementData
    - {static} _map_asset(item: dict): AssetItem
    - {static} _map_liability(item: dict): LiabilityItem
  }

  class JSONFinancialStatementRepository {
    + path: Path
    + reader: JSONReader
    + standardizer: DataStandardizer
    + validator: FinancialDataValidator
    + mapper: FinancialStatementMapper
    + __init__(path)
    + load(): FinancialStatementData or FinancialTimeSeriesData
  }
}

package "Domain Layer" #E3F0F8 {
  interface FinancialStatementRepository <<Protocol>> {
    + load(): FinancialStatementData or FinancialTimeSeriesData
  }
  class Money <<value object>>
  class ReportingPeriod <<value object>>
  class Company <<entity>>
  class AssetItem <<entity>>
  class AssetStatement <<entity>>
  class LiabilityItem <<entity>>
  class LiabilityStatement <<entity>>
  class FinancialStatementData <<aggregate>>
  class FinancialTimeSeriesData <<aggregate>>
}

class ValueError <<Python standard library>>

DataValidationError --|> ValueError
JSONFinancialStatementRepository ..|> FinancialStatementRepository
JSONFinancialStatementRepository *-- JSONReader
JSONFinancialStatementRepository *-- DataStandardizer
JSONFinancialStatementRepository *-- FinancialDataValidator
JSONFinancialStatementRepository *-- FinancialStatementMapper

JSONReader ..> DataValidationError : raises
FinancialDataValidator ..> DataValidationError : raises
FinancialDataValidator ..> Money : validates amount

FinancialStatementMapper ..> Money : constructs
FinancialStatementMapper ..> ReportingPeriod : constructs
FinancialStatementMapper ..> Company : constructs
FinancialStatementMapper ..> AssetItem : constructs
FinancialStatementMapper ..> AssetStatement : constructs
FinancialStatementMapper ..> LiabilityItem : constructs
FinancialStatementMapper ..> LiabilityStatement : constructs
FinancialStatementMapper ..> FinancialStatementData : returns
FinancialStatementMapper ..> FinancialTimeSeriesData : returns

note right of JSONFinancialStatementRepository
  Pipeline:
  read -> standardize -> validate -> map
end note

note bottom of FinancialDataValidator
  Checks required fields, section types,
  unique names, non-negative finite amounts,
  the presence of at least one asset, and
  optional liability sections, unique periods,
  and matching time-frame boundaries.
end note

@enduml
