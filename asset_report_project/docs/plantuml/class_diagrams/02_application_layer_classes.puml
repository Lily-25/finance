@startuml ApplicationLayerClasses

title Financial Position Report Generator - Application Layer Classes
top to bottom direction

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam classAttributeIconSize 0

package "Application Facade and Configuration\nasset_report.application.app" #E3EEFF {
  class ApplicationConfig <<frozen dataclass>> {
    + default_output: Path = build/time-frame-report.html
  }

  class DependencyContainer {
    + financial_analysis_service(): FinancialAnalysisService
    + generate_time_frame_report(): GenerateTimeFrameReport
  }

  class FinancialAnalysisApp {
    - config: ApplicationConfig
    - container: DependencyContainer
    + __init__(config: ApplicationConfig = None, container: DependencyContainer = None)
    + analyze_time_frame(input_paths): TimeFrameAnalysisResult
    + generate_time_frame_report(input_paths, output_path = None, title = None): Path
    - {static} _normalize_period_paths(input_paths): tuple
  }
}

package "Use Cases\nasset_report.application.use_cases" #E9F0FF {
  class GenerateTimeFrameReport {
    - analysis_service: FinancialAnalysisService
    - chart_generator: ChartGenerator
    - report_builder: ReportBuilder
    - exporter: ReportFileExporter
    + __init__(analysis_service, chart_generator, report_builder, exporter)
    + execute(repository, destination, report_title = None): Path
  }
}

package "Business Logic Layer" #E2F3E7 {
  class FinancialAnalysisService
  class FinancialAnalysisResult <<frozen dataclass>>
  class TimeFrameAnalysisResult <<frozen dataclass>>
}

package "Domain Layer" #E3F0F8 {
  interface FinancialStatementRepository
}

package "Data Access Layer" #FFF0DA {
  class JSONFinancialStatementRepository
}

package "Output Layer" #EEE5FA {
  interface ChartGenerator
  class FinancialCharts
  class ReportBuilder
  class ReportFileExporter
}

FinancialAnalysisApp *-- ApplicationConfig
FinancialAnalysisApp *-- DependencyContainer
FinancialAnalysisApp ..> JSONFinancialStatementRepository : creates from one or more paths
FinancialAnalysisApp ..> GenerateTimeFrameReport : requests
FinancialAnalysisApp ..> FinancialAnalysisService : requests direct analysis
FinancialAnalysisApp ..> TimeFrameAnalysisResult : returns

DependencyContainer ..> GenerateTimeFrameReport : assembles
DependencyContainer ..> FinancialAnalysisService : creates
DependencyContainer ..> FinancialCharts : creates
DependencyContainer ..> ReportBuilder : creates
DependencyContainer ..> ReportFileExporter : creates

GenerateTimeFrameReport --> FinancialStatementRepository : load()
GenerateTimeFrameReport --> FinancialAnalysisService : analyze()
GenerateTimeFrameReport --> ChartGenerator : generate()
GenerateTimeFrameReport --> ReportBuilder : build()
GenerateTimeFrameReport --> ReportFileExporter : export()

note right of GenerateTimeFrameReport
  Normalizes one statement to a one-period series,
  then enforces exactly four charts before export.
end note

@enduml
