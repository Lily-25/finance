@startuml BusinessLogicLayerClasses

title Asset Report Generator - Business Logic Layer Classes
left to right direction

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam classAttributeIconSize 0

package "Business Logic Layer\nasset_report.business.analysis" #E2F3E7 {
  class MetricsCalculator {
    + {static} percentage(part: Money, whole: Money): Decimal
  }

  class AssetMetric <<frozen dataclass>> {
    + name: str
    + classification: str
    + amount: Money
    + percentage_of_class: Decimal
    + percentage_of_total: Decimal
  }

  class AssetAnalysisResult <<frozen dataclass>> {
    + data: AssetReportData
    + current_total: Money
    + non_current_total: Money
    + total_assets: Money
    + current_percentage: Decimal
    + non_current_percentage: Decimal
    + current_metrics: tuple(AssetMetric)
    + non_current_metrics: tuple(AssetMetric)
    + all_metrics: tuple(AssetMetric) {property}
  }

  class AssetAnalysisService {
    - calculator: MetricsCalculator
    + __init__(calculator: MetricsCalculator = None)
    + analyze(data: AssetReportData): AssetAnalysisResult
    - _metrics(items, classification, class_total, total_assets): tuple(AssetMetric)
  }
}

package "Domain Layer" #E3F0F8 {
  class Money <<value object>>
  class AssetReportData <<aggregate>>
  class AssetItem <<entity>>
}

AssetAnalysisService *-- MetricsCalculator
AssetAnalysisService ..> AssetReportData : consumes
AssetAnalysisService ..> AssetItem : iterates
AssetAnalysisService ..> AssetAnalysisResult : creates
AssetAnalysisService ..> AssetMetric : creates

AssetAnalysisResult *-- "0..*" AssetMetric
AssetAnalysisResult --> AssetReportData
AssetAnalysisResult --> Money : totals
AssetMetric --> Money : amount
MetricsCalculator ..> Money

note bottom of AssetAnalysisService
  Uses Decimal-backed Money values.
  Rejects an all-zero asset statement.
  Sorts line items from largest to smallest.
end note

@enduml
