@startuml FinancialReportSystemClasses

title Financial Position Report Generator - System Class Diagram
top to bottom direction

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam nodesep 35
skinparam ranksep 48

package "Presentation Layer" #DCEBFA {
  class CLI <<module>>
}

package "Application Layer" #E3EEFF {
  class ApplicationConfig <<dataclass>>
  class DependencyContainer
  class FinancialAnalysisApp
  class GenerateFinancialReport
}

package "Business Logic Layer" #E2F3E7 {
  class MetricsCalculator
  class FinancialAnalysisService
  class FinancialMetric <<dataclass>>
  class FinancialAnalysisResult <<dataclass>>
  class TimeFrameAnalysisResult <<dataclass>>
}

package "Domain Layer" #E3F0F8 {
  class Money <<value object>>
  class ReportingPeriod <<value object>>
  class Company <<entity>>
  class AssetItem <<entity>>
  class AssetStatement <<entity>>
  class LiabilityItem <<entity>>
  class LiabilityStatement <<entity>>
  class FinancialStatementData <<aggregate>>
  class FinancialTimeSeriesData <<aggregate>>
  interface FinancialStatementRepository
}

package "Data Access Layer" #FFF0DA {
  class JSONReader
  class DataStandardizer
  class FinancialDataValidator
  class FinancialStatementMapper
  class JSONFinancialStatementRepository
  class DataValidationError
}

package "Output Layer" #EEE5FA {
  class Chart <<dataclass>>
  interface ChartGenerator
  class FinancialCharts
  class NarrativeGenerator
  class ReportTemplate
  class ReportBuilder
  class ReportFileExporter
}

CLI ..> FinancialAnalysisApp : invokes

FinancialAnalysisApp *-- ApplicationConfig
FinancialAnalysisApp *-- DependencyContainer
FinancialAnalysisApp ..> JSONFinancialStatementRepository : one or more JSON paths
DependencyContainer ..> GenerateFinancialReport : assembles

GenerateFinancialReport --> FinancialStatementRepository : loads
GenerateFinancialReport --> FinancialAnalysisService : analyzes
GenerateFinancialReport --> ChartGenerator : renders charts
GenerateFinancialReport --> ReportBuilder : builds HTML
GenerateFinancialReport --> ReportFileExporter : exports

JSONFinancialStatementRepository ..|> FinancialStatementRepository
JSONFinancialStatementRepository *-- JSONReader
JSONFinancialStatementRepository *-- DataStandardizer
JSONFinancialStatementRepository *-- FinancialDataValidator
JSONFinancialStatementRepository *-- FinancialStatementMapper
JSONReader ..> DataValidationError : raises
FinancialDataValidator ..> DataValidationError : raises
FinancialDataValidator ..> Money : validates
FinancialStatementMapper ..> FinancialStatementData : maps
FinancialStatementMapper ..> FinancialTimeSeriesData : maps

FinancialAnalysisService *-- MetricsCalculator
FinancialAnalysisService ..> FinancialStatementData
FinancialAnalysisService ..> FinancialTimeSeriesData
FinancialAnalysisService ..> FinancialAnalysisResult : creates
FinancialAnalysisService ..> TimeFrameAnalysisResult : creates
FinancialAnalysisResult *-- "0..*" FinancialMetric
TimeFrameAnalysisResult *-- "2..*" FinancialAnalysisResult
FinancialMetric --> Money

Company *-- ReportingPeriod
FinancialStatementData *-- Company
FinancialStatementData *-- AssetStatement
FinancialStatementData *-- LiabilityStatement
FinancialTimeSeriesData *-- Company
FinancialTimeSeriesData *-- "2..*" FinancialStatementData
AssetStatement *-- "0..*" AssetItem : current assets
AssetStatement *-- "0..*" AssetItem : non-current assets
AssetItem *-- Money
LiabilityStatement *-- "0..*" LiabilityItem : current liabilities
LiabilityStatement *-- "0..*" LiabilityItem : non-current liabilities
LiabilityItem *-- Money
FinancialStatementRepository ..> FinancialStatementData
FinancialStatementRepository ..> FinancialTimeSeriesData

FinancialCharts ..|> ChartGenerator
FinancialCharts ..> FinancialAnalysisResult
FinancialCharts ..> TimeFrameAnalysisResult
FinancialCharts ..> Chart : creates four
ReportBuilder *-- NarrativeGenerator
ReportBuilder *-- ReportTemplate
ReportBuilder ..> FinancialAnalysisResult
ReportBuilder ..> TimeFrameAnalysisResult
ReportBuilder ..> Chart
NarrativeGenerator ..> FinancialAnalysisResult
NarrativeGenerator ..> TimeFrameAnalysisResult

note right of GenerateFinancialReport
  Coordinates the complete pipeline:
  load -> analyze -> chart -> build -> export
end note

note right of JSONFinancialStatementRepository
  One file produces one snapshot.
  Multiple period files are ordered and
  composed into FinancialTimeSeriesData.
end note

legend bottom
  |= Relation |= Meaning |
  | *-- | Composition / ownership |
  | --> | Runtime collaboration |
  | ..> | Dependency / creation |
  | ..|> | Interface implementation |
endlegend

@enduml
