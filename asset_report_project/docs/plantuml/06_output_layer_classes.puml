@startuml OutputLayerClasses

title Financial Position Report Generator - Output Layer Classes
top to bottom direction

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam classAttributeIconSize 0

package "Visualization\nasset_report.output.charts" #EEE5FA {
  class Chart <<frozen dataclass>> {
    + title: str
    + subtitle: str
    + svg: str
  }

  interface ChartGenerator <<abstract>> {
    + generate(result: FinancialAnalysisResult): tuple(Chart)
  }

  class FinancialCharts {
    + generate(result: FinancialAnalysisResult): tuple(Chart)
    - _structure_donut(title, total_label, amounts, percentages, currency, labels): str
    - _horizontal_bars(metrics, title, percentage_basis): str
    - _empty_chart(title: str, message: str): str
    - _legend_row(x, y, color, label, value): str
    - {static} _percent(value: Decimal): str
    - {static} _amount(value: Decimal): str
  }
}

package "Reporting and Export\nasset_report.output.reporting" #F3EDFA {
  class NarrativeGenerator {
    + generate(result: FinancialAnalysisResult): tuple(str)
  }

  class ReportTemplate {
    + CSS: str
    + render(title: str, body: str): str
  }

  class ReportBuilder {
    - narrative_generator: NarrativeGenerator
    - template: ReportTemplate
    + __init__(narrative_generator = None, template = None)
    + build(result, charts, report_title = None): str
    - {static} _kpis(result): str
    - {static} _chart_card(chart: Chart): str
    - _asset_table(result): str
    - _liability_table(result): str
    - {static} _metric_rows(metrics, currency, percentage_field): list(str)
  }

  class ReportFileExporter {
    + export(html: str, destination): Path
  }
}

package "Business Logic Layer" #E2F3E7 {
  class FinancialAnalysisResult
  class FinancialMetric
}

FinancialCharts ..|> ChartGenerator
FinancialCharts ..> FinancialAnalysisResult : consumes
FinancialCharts ..> FinancialMetric : visualizes
FinancialCharts ..> Chart : creates four

NarrativeGenerator ..> FinancialAnalysisResult : interprets
ReportBuilder *-- NarrativeGenerator
ReportBuilder *-- ReportTemplate
ReportBuilder ..> FinancialAnalysisResult : summarizes
ReportBuilder ..> Chart : embeds SVG

note right of FinancialCharts
  Produces four inline, accessible SVGs:
  1. Asset structure donut
  2. Liability structure donut
  3. Largest asset categories
  4. Largest liability categories
end note

note right of ReportFileExporter
  Creates parent directories and writes
  through a temporary file before replace.
end note

@enduml
