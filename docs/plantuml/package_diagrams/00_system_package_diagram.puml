@startuml FinancialReportSystemPackages

title Financial Position Report Generator - System Package Diagram
top to bottom direction

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam componentStyle rectangle
skinparam nodesep 40
skinparam ranksep 55

package "asset_report.presentation" as Presentation #DCEBFA {
  [cli.py] as CLI
}

package "asset_report.application" as Application #E3EEFF {
  [app.py] as AppModule
  [use_cases.py] as UseCasesModule
}

package "asset_report.business" as Business #E2F3E7 {
  [analysis.py] as AnalysisModule
}

package "asset_report.domain" as Domain #E3F0F8 {
  [models.py] as ModelsModule
  [repositories.py] as RepositoriesModule
}

package "asset_report.data_access" as DataAccess #FFF0DA {
  [json_repository.py] as JSONRepositoryModule
}

package "asset_report.output" as Output #EEE5FA {
  [charts.py] as ChartsModule
  [reporting.py] as ReportingModule
}

CLI ..> AppModule : imports facade
CLI ..> JSONRepositoryModule : handles validation error

AppModule ..> UseCasesModule
AppModule ..> AnalysisModule
AppModule ..> JSONRepositoryModule
AppModule ..> ChartsModule
AppModule ..> ReportingModule

UseCasesModule ..> AnalysisModule
UseCasesModule ..> RepositoriesModule : imports contract
UseCasesModule ..> ChartsModule : imports chart port
UseCasesModule ..> ReportingModule

AnalysisModule ..> ModelsModule
RepositoriesModule ..> ModelsModule
JSONRepositoryModule ..> ModelsModule
JSONRepositoryModule ..> RepositoriesModule : structurally satisfies contract\n(no runtime import)

ChartsModule ..> AnalysisModule
ReportingModule ..> AnalysisModule
ReportingModule ..> ChartsModule

note bottom of Domain
  Stable core with no dependency on
  another asset_report layer. It owns the
  asset, liability, equity, and source-provenance models.
end note

legend bottom
  Package colors and layer names match the paired class diagrams.
  Dashed arrows are actual Python import dependencies except the
  explicitly labeled structural repository-contract relationship.
endlegend

@enduml
