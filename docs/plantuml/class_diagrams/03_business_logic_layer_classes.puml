@startuml BusinessLogicLayerClasses

title Financial Position Report Generator - Business Logic Layer Classes
left to right direction

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam classAttributeIconSize 0

package "Business Logic Layer\nasset_report.business.analysis" #E2F3E7 {
  class MetricsCalculator {
    + {static} percentage(part: Money or SignedMoney, whole: Money or SignedMoney): Decimal
    + {static} ratio(numerator: Money or SignedMoney, denominator: Money or SignedMoney): Decimal [0..1]
    + {static} change_percentage(start: Decimal, end: Decimal): Decimal [0..1]
  }

  class FinancialMetric <<frozen dataclass>> {
    + name: str
    + statement_type: str
    + classification: str
    + amount: Money or SignedMoney
    + percentage_of_class: Decimal
    + percentage_of_statement: Decimal
    + percentage_of_assets: Decimal
    + source_field: str
    + description: str
  }

  class FinancialAnalysisResult <<frozen dataclass>> {
    + data: FinancialStatementData
    + current_total: Money
    + non_current_total: Money
    + total_assets: Money
    + current_percentage: Decimal
    + non_current_percentage: Decimal
    + current_metrics: tuple(FinancialMetric)
    + non_current_metrics: tuple(FinancialMetric)
    + current_liabilities_total: Money
    + non_current_liabilities_total: Money
    + total_liabilities: Money
    + total_equity: SignedMoney
    + equity_metrics: tuple(FinancialMetric)
    + liability_to_assets_percentage: Decimal
    + equity_to_assets_percentage: Decimal
    + net_assets: Decimal
    + balance_difference: Decimal
    + is_balanced: bool
    + current_ratio: Decimal [0..1]
    + all_asset_metrics: tuple(FinancialMetric) {property}
    + all_liability_metrics: tuple(FinancialMetric) {property}
    + all_equity_metrics: tuple(FinancialMetric) {property}
  }

  class FinancialAnalysisService {
    - calculator: MetricsCalculator
    + __init__(calculator: MetricsCalculator = None)
    + analyze(data: FinancialStatementData or FinancialTimeSeriesData): FinancialAnalysisResult or TimeFrameAnalysisResult
    - _analyze_statement(data: FinancialStatementData): FinancialAnalysisResult
    - _metrics(items, statement_type, classification, class_total, statement_total, total_assets): tuple(FinancialMetric)
  }

  class TimeFrameAnalysisResult <<frozen dataclass>> {
    + data: FinancialTimeSeriesData
    + period_results: tuple(FinancialAnalysisResult)
    + first: FinancialAnalysisResult {property}
    + latest: FinancialAnalysisResult {property}
    + asset_change: Decimal {property}
    + asset_change_percentage: Decimal [0..1] {property}
    + liability_change: Decimal {property}
    + liability_change_percentage: Decimal [0..1] {property}
    + net_asset_change: Decimal {property}
    + equity_change: Decimal {property}
    + equity_change_percentage: Decimal [0..1] {property}
    + liability_ratio_change_points: Decimal {property}
  }
}

package "Domain Layer" #E3F0F8 {
  class Money <<value object>>
  class SignedMoney <<value object>>
  class FinancialStatementData <<aggregate>>
  class FinancialTimeSeriesData <<aggregate>>
  class AssetItem <<entity>>
  class LiabilityItem <<entity>>
  class EquityItem <<entity>>
}

FinancialAnalysisService *-- MetricsCalculator
FinancialAnalysisService ..> FinancialStatementData : consumes
FinancialAnalysisService ..> FinancialTimeSeriesData : consumes
FinancialAnalysisService ..> AssetItem : iterates
FinancialAnalysisService ..> LiabilityItem : iterates
FinancialAnalysisService ..> EquityItem : iterates
FinancialAnalysisService ..> FinancialAnalysisResult : creates
FinancialAnalysisService ..> TimeFrameAnalysisResult : creates
FinancialAnalysisService ..> FinancialMetric : creates

FinancialAnalysisResult *-- "0..*" FinancialMetric
FinancialAnalysisResult --> FinancialStatementData
TimeFrameAnalysisResult *-- "1..*" FinancialAnalysisResult
TimeFrameAnalysisResult --> FinancialTimeSeriesData
FinancialAnalysisResult --> Money : totals
FinancialMetric --> Money : amount
FinancialMetric --> SignedMoney : signed equity amount
MetricsCalculator ..> Money
MetricsCalculator ..> SignedMoney

note bottom of FinancialAnalysisService
  Uses Decimal-backed Money and SignedMoney values.
  Rejects an all-zero asset statement.
  Calculates snapshot composition, ratios, equity,
  provenance, and accounting-equation status.
  A one-period series produces snapshot metrics;
  longer series add first-to-latest changes.
end note

@enduml
