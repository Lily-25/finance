@startuml OutputLayerClasses

title Financial Position Report Generator - Output Layer Classes
top to bottom direction

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam classAttributeIconSize 0

package "Visualization\nasset_report.output.charts" #EEE5FA {
  class Chart <<frozen dataclass>> {
    + title: str
    + subtitle: str
    + svg: str
  }

  interface ChartGenerator <<abstract>> {
    + generate(result: FinancialAnalysisResult or TimeFrameAnalysisResult): tuple(Chart)
  }

  class FinancialCharts {
    + generate(result: FinancialAnalysisResult or TimeFrameAnalysisResult): tuple(Chart)
    - _time_frame_charts(result: TimeFrameAnalysisResult): tuple(Chart)
    - _comparison_bars(result: TimeFrameAnalysisResult): str
    - _line_chart(title, labels, values, color, value_format): str
    - _structure_donut(title, total_label, amounts, percentages, currency, labels): str
    - _horizontal_bars(metrics, title, percentage_basis): str
    - _empty_chart(title: str, message: str): str
    - _legend_row(x, y, color, label, value): str
    - {static} _percent(value: Decimal): str
    - {static} _amount(value: Decimal): str
  }
}

package "Reporting and Export\nasset_report.output.reporting" #F3EDFA {
  class NarrativeGenerator {
    + generate(result: FinancialAnalysisResult or TimeFrameAnalysisResult): tuple(str)
    - _generate_time_frame(result: TimeFrameAnalysisResult): tuple(str)
  }

  class ReportTemplate {
    + CSS: str
    + render(title: str, body: str): str
  }

  class ReportBuilder {
    - narrative_generator: NarrativeGenerator
    - template: ReportTemplate
    + __init__(narrative_generator = None, template = None)
    + build(result, charts, report_title = None): str
    - _build_time_frame(result, charts, report_title): str
    - {static} _time_frame_kpis(result): str
    - {static} _time_frame_table(result): str
    - {static} _kpis(result): str
    - {static} _chart_card(chart: Chart): str
    - _asset_table(result): str
    - _liability_table(result): str
    - {static} _metric_rows(metrics, currency, percentage_field): list(str)
  }

  class ReportFileExporter {
    + export(html: str, destination): Path
  }
}

package "Ratio Trend Reporting\nasset_report.output.ratio_reporting" #E7DFF5 {
  class FinancialRatioNarrativeGenerator {
    + generate(result: FinancialRatioAnalysisResult): tuple(str)
    - _first_available(result, attribute): tuple
    - _movement_from_pair(label, start, end, formatting): str
  }

  class FinancialRatioReportBuilder {
    - narrative_generator: FinancialRatioNarrativeGenerator
    + build(result: FinancialRatioAnalysisResult, report_title = None): str
    - _table(result, metrics): str
    - _kpi(label, value, kind, currency): str
    - _value(value, kind, currency): str
  }
}

package "Business Logic Layer" #E2F3E7 {
  class FinancialAnalysisResult
  class FinancialMetric
  class TimeFrameAnalysisResult
  class FinancialRatioAnalysisResult
}

FinancialCharts ..|> ChartGenerator
FinancialCharts ..> FinancialAnalysisResult : consumes
FinancialCharts ..> TimeFrameAnalysisResult : consumes
FinancialCharts ..> FinancialMetric : visualizes
FinancialCharts ..> Chart : creates four

NarrativeGenerator ..> FinancialAnalysisResult : interprets
NarrativeGenerator ..> TimeFrameAnalysisResult : interprets
ReportBuilder *-- NarrativeGenerator
ReportBuilder *-- ReportTemplate
ReportBuilder ..> FinancialAnalysisResult : summarizes
ReportBuilder ..> TimeFrameAnalysisResult : summarizes
ReportBuilder ..> Chart : embeds SVG

FinancialRatioNarrativeGenerator ..> FinancialRatioAnalysisResult : interprets
FinancialRatioReportBuilder *-- FinancialRatioNarrativeGenerator
FinancialRatioReportBuilder ..> FinancialRatioAnalysisResult : summarizes

note right of FinancialCharts
  Produces four accessible SVGs for either mode.
  Snapshot: structure and category charts.
  Time frame: assets/liabilities/equity, reported equity,
  current ratio, and leverage trends.
end note

note right of ReportFileExporter
  Creates parent directories and writes
  through a temporary file before replace.
end note

@enduml
